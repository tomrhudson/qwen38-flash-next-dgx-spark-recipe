# Copy this file to .env and customize only your local topology.
# Never commit .env. Shell environment variables override values in this file.

# Direct ConnectX-7 RoCE link. These are documentation-only example addresses.
HEAD_CX7_IP=10.0.22.1
WORKER_CX7_IP=10.0.22.2
HEAD_CX7_IF=enp1s0f1np1
WORKER_CX7_IF=enp1s0f0np0
HEAD_CX7_IB=rocep1s0f1
WORKER_CX7_IB=rocep1s0f0

# Passwordless SSH target for the second Spark.
WORKER_USER=
WORKER_HOST=spark2
# WORKER_SSH=user@worker-host

# The OpenAI-compatible API has no built-in authentication. Loopback is the
# safe default; bind to a private interface only when protected by a firewall.
PORT=8888
HOST_BIND=127.0.0.1
DIST_PORT=26400

# Validated native-context recipe.
MEM_FRACTION_STATIC=0.78
MAX_MAMBA_CACHE_SIZE=40
CONTEXT_LENGTH=262144
CHUNKED_PREFILL_SIZE=2048
MAX_RUNNING_REQUESTS=16

# NEXTN speculative decoding.
SPEC_STEPS=3
SPEC_TOPK=1
SPEC_DRAFT=4

# Qwen sparse-attention and Mamba state-cache constraints.
PLE_OFFLOAD=
MAMBA_RADIX_CACHE_STRATEGY=extra_buffer
MAMBA_TRACK_INTERVAL=64
MAMBA_FULL_MEMORY_RATIO=

# Decode graph sizes proven to fit the GB10 pool.
ENABLE_DECODE_GRAPHS=1
CUDA_GRAPH_BS=1 2 3 4 5 6 7 8 10 12 14 16

# Backend and model identity.
ATTENTION_BACKEND=flashinfer
KV_CACHE_DTYPE=
FP4_GEMM_BACKEND=
LINEAR_ATTN_PREFILL_BACKEND=
LINEAR_ATTN_DECODE_BACKEND=
SERVED_MODEL_NAME=Qwen3.8-Flash-Next-NVFP4
KERNEL_PATCH=1
BASE_IMAGE=lmsysorg/sglang:qwen38flashnext
PATCHED_IMAGE=qwen38-flashnext-dspark:local

# Operations. The launcher falls back to the image-bundled NCCL when the
# optional staged host build is absent.
DOWNLOAD_MODE=rsync
USE_HOST_NCCL=1
WAIT_TIMEOUT_MIN=90
NCCL_DEBUG=WARN
NCCL_CROSS_NIC=0
CPUSET=5-9,15-19
REASONING_PARSER=auto
TOOL_CALL_PARSER=auto

# Keep credentials outside this repository. The model is public, so a token is
# optional; export HF_TOKEN in your shell only if rate limits require one.
HF_REVISION=
HF_TOKEN=
EXTRA_ARGS=
